# Salin file ini jadi .env dan isi nilai aslinya. JANGAN pernah commit file .env asli.

# Didapat dari service Postgres di Railway (bukan punya n8n!)
DATABASE_URL=postgresql://user:password@host:port/dbname

# String acak panjang buat enkripsi session cookie - generate sekali, simpan
SESSION_SECRET=ganti-dengan-string-acak-panjang

# Login admin pertama (dipakai oleh script seed-admin.js sekali di awal)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-dengan-password-asli

# Port lokal untuk development (Railway production pakai PORT dari env otomatis)
PORT=4000

# Alamat asal situs statis yang boleh akses API ini (buat CORS)
STATIC_SITE_ORIGIN=http://localhost:8098

# Folder penyimpanan foto upload (di Railway ini akan jadi path mount Volume, mis. /data/uploads)
UPLOAD_DIR=./uploads
